# Supabase - Get these from your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Site URL (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 (image storage) — Server-side credentials
# Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=luxor-smart-mall

# Public base URL of the bucket (R2 → bucket → Settings → Public access)
# Either the r2.dev subdomain or a custom domain (recommended for performance)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# Cloudflare Image Resizing (faster images, NO Vercel optimization) ──────────
# When images are served from a CUSTOM domain on a Cloudflare zone with
# "Image Resizing" turned ON, the app rewrites image URLs to /cdn-cgi/image/...
# so the edge delivers correctly sized WebP/AVIF instead of the full-resolution
# original. Auto-enabled for custom domains, auto-disabled for pub-*.r2.dev
# (which can't resize). 1 = force ON, 0 = force OFF. Leave unset for automatic.
# NEXT_PUBLIC_CF_IMAGE_RESIZING=1
